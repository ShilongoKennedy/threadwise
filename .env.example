# Public Supabase settings, from your Supabase project API settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Either the newer publishable key or legacy anon key works. Use one, not both.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side equivalents for TanStack Start routes and server functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Required only for the AI access-pause feature; never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side only. Obtain this from platform.deepseek.com; do not commit the real key.
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional; defaults to deepseek-chat.
DEEPSEEK_MODEL=deepseek-chat

# Local testing only. This permits DeepSeek features without an account strictly
# on localhost/127.0.0.1; never set it in Vercel or any deployed environment.
ALLOW_LOCAL_AI_UNAUTHENTICATED=false
