# Public Supabase settings, from your Supabase project API settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side equivalents for TanStack Start routes and server functions.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Required only for the AI access-pause feature; never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-side only. Obtain this from platform.deepseek.com; do not commit the real key.
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional; defaults to deepseek-chat.
DEEPSEEK_MODEL=deepseek-chat
